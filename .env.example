# Public Supabase configuration used by the browser and Capacitor WebView.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
VITE_SUPABASE_ANON_KEY=your_legacy_public_anon_key
VITE_CLARITY_PROJECT_ID=your_clarity_project_id

# Server-side names used to validate bearer tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
SUPABASE_ANON_KEY=your_legacy_public_anon_key

# Keep the Gemini API key server-side in production.
GEMINI_API_KEY=your_server_only_gemini_key
CORS_ORIGINS=https://your-web-domain.example,capacitor://localhost,http://localhost
